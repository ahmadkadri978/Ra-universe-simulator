{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "outDir": ".offline-build",
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true
  },
  "include": [
    "src/domain/**/*.ts",
    "src/sources/**/*.ts",
    "src/simulation/**/*.ts"
  ],
  "exclude": ["**/*.test.ts", "src/simulation/store/**"]
}
